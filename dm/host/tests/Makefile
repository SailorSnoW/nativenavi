# dm/host unit tests in one command: make -C dm/host/tests GAME=<base game title ID> run (takes seconds; build output goes to build/ and is not committed)
B = build
PYTHON ?= python3
# SAN: extra compiler flags for a sanitizer or coverage build (make asan, make tsan-threads and make coverage below set it, with B = a build folder of their own); empty otherwise
SAN ?=
CLANG = clang $(SAN)
# stderr that the plain run hides is kept in sanitizer builds: the sanitizers report there
QUIET = $(if $(findstring -fsanitize,$(SAN)),,2>/dev/null)
.DEFAULT_GOAL := run
# game profile header (dm.h needs game_profile.h, generated by the host Makefile into ../gen/<profile>/)
# the game profile the tests are built for: Ocarina of Time's unless GAME names another
GAME ?= 0400486024DEC000
GINC = -I../gen/$(GAME) -I../../games/$(GAME)
$(B)/t_fs $(B)/t_fs_case $(B)/t_fs_commit $(B)/t_fs_commit_tsan: ../romfs_image.h
GAME_H = ../gen/$(GAME)/game_profile.h
run: $(B)/t_mods $(B)/t_mii $(B)/t_net_eventfd $(B)/t_motion $(B)/t_heap_size $(B)/t_oe $(B)/t_friends $(B)/t_fs $(B)/t_fs_commit $(B)/t_thread_leak $(B)/t_fs_case $(B)/t_audio $(B)/t_output_stream $(B)/t_audio_spsc $(B)/t_altstack $(B)/t_condvar $(B)/t_condvar_old $(B)/t_pollwait $(B)/t_clockwait $(B)/t_pause $(B)/t_pause_stress $(B)/t_pctl $(B)/t_sf $(B)/t_time $(B)/t_shared_font $(B)/t_hid $(B)/t_haptics $(B)/t_haptics_apple $(B)/t_pad_hid $(B)/t_switch2
	$(B)/t_heap_size
	$(B)/t_oe $(QUIET)
	$(B)/t_friends
	$(B)/t_fs $(QUIET)
	$(B)/t_fs_mutation $(QUIET)
	TMPDIR="$(abspath $(B))" $(B)/t_fs_commit
	$(B)/t_thread_leak
	TMPDIR="$(abspath $(B))" $(B)/t_fs_case $(QUIET)
	$(B)/t_audio
	$(B)/t_output_stream
	$(B)/t_mii
	$(B)/t_audio_spsc
	$(B)/t_audio_stats
	$(B)/t_audren_work
	$(B)/t_audren_layout
	$(B)/t_altstack
	$(B)/t_bigstack
	$(B)/t_condvar
	$(B)/t_condvar_old
	$(B)/t_pollwait
	$(B)/t_clockwait
	$(B)/t_preempt
	$(B)/t_preempt --all-peers
	$(B)/t_pause
	$(B)/t_pause_stress --seconds 1
	$(B)/t_pctl
	$(B)/t_net_eventfd
	$(B)/t_net_loopback
	$(B)/t_sf
	$(B)/t_time
	$(B)/t_sync_wait $(QUIET)
	$(B)/t_shared_font
	$(B)/t_system_event
	$(B)/t_codec_opus
	$(B)/t_codec_video
	$(B)/t_objmap
	TMPDIR="$(abspath $(B))" $(B)/t_nfc
	$(B)/t_motion
	$(B)/t_motion_apple
	$(B)/t_pad_apple
	$(B)/t_account
	$(B)/t_home_quit
	$(B)/t_home_quit_mac
	$(B)/t_ctrl_prompt
	$(B)/t_motion_pro
	$(B)/t_motion_pro_mac
	$(B)/t_jc1
	TMPDIR="$(abspath $(B))" $(B)/t_hid
	$(B)/t_pad_hid
	$(B)/t_pad_hid_mac
	$(B)/t_pad_pro
	$(B)/t_switch2
	$(B)/t_haptics
	$(B)/t_haptics_apple
	$(B)/t_front_role
	TMPDIR="$(abspath $(B))" $(B)/t_mods $(QUIET)
	$(B)/t_symbols
