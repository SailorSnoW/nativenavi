<!-- Switch shader → SPIR-V translation tool (built with dm/tools/native_tools.sh). It references the Ryujinx shader translator source kept in the repository (dm/third_party/ryujinx); -p:RyuSrc=<dir> points it at another copy. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- A native executable (NativeAOT), so running it needs no .NET: dm/tools/native_tools.sh publishes it for arm64 and x86_64 and joins them into dm/gfx/tools/dmsh_xlate_bin/dmsh_xlate -->
    <PublishAot>true</PublishAot>
    <RyuSrc Condition="'$(RyuSrc)' == ''">$(MSBuildThisFileDirectory)../../../third_party/ryujinx</RyuSrc>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Graphics.Shader/Ryujinx.Graphics.Shader.csproj" />
    <ProjectReference Include="$(RyuSrc)/src/Ryujinx.Common/Ryujinx.Common.csproj" />
  </ItemGroup>
  <!-- The digest of its sources and the vendored Ryujinx ones, which native_tools.sh passes (the XlateSourceSha property, from dmsh_chain.py): its source-sha argument prints it -->
  <PropertyGroup>
    <XlateSourceSha Condition="'$(XlateSourceSha)' == ''">unknown</XlateSourceSha>
  </PropertyGroup>
  <Target Name="WriteXlateSourceSha" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_XlateSourceShaFile>$(IntermediateOutputPath)XlateSourceSha.g.cs</_XlateSourceShaFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(_XlateSourceShaFile)" Lines="static partial class SwshXlate { const string SourceSha = &quot;$(XlateSourceSha)&quot;%3B }" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_XlateSourceShaFile)" />
    </ItemGroup>
  </Target>
</Project>
