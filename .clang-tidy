# Bug-finding checks and the static analyzer for dm/host and dm/gfx (dm/tools/lint_c.py tidy); findings are held to dm/tools/lint_c_baseline.tsv.
# A disabled check mostly flags a deliberate idiom of this code; its line says which.
Checks:
  - -*
  - bugprone-*                                    # includes the bug-finding CERT C rules (cert-flp30-c, cert-str34-c are aliases)
  - -bugprone-signed-bitwise                      # guest registers, bitfields and masks are int arithmetic on purpose
  - -bugprone-unchecked-string-to-number-conversion  # a bad DM_* switch or table value reading as 0 (off) is intended
  - -bugprone-easily-swappable-parameters         # style
  - -bugprone-narrowing-conversions               # guest values change width on purpose
  - -bugprone-implicit-widening-of-multiplication-result
  - -bugprone-reserved-identifier                 # __-prefixed names of the guest ABI and the SDK
  - -bugprone-assignment-in-if-condition          # `if ((p = find(...)))` is house style
  - -bugprone-assignment-in-selection-statement   # LLVM 23 name of the same check
  - -bugprone-switch-missing-default-case         # decoder switches handle the cases that exist
  - -bugprone-unhandled-code-paths                # LLVM 23 name of the same check
  - -bugprone-branch-clone                        # identical branches in decoders and format tables
  - -bugprone-multi-level-implicit-pointer-conversion
  - -bugprone-casting-through-void                # guest memory is reached through void *
  - -bugprone-macro-parentheses                   # style
  - -bugprone-integer-division                    # deliberate in layout math
  - -bugprone-suspicious-include                  # tests include the .c file they test to reach its statics
  - -bugprone-inc-dec-in-conditions               # && and || sequence their operands; -Wunsequenced covers the rest
  - clang-analyzer-core.*
  - clang-analyzer-unix.*
  - clang-analyzer-security.FloatLoopCounter
  - clang-analyzer-security.ArrayBound
  - clang-analyzer-nullability.*
  - clang-analyzer-osx.*
  - misc-redundant-expression
  - misc-misplaced-const
CheckOptions:
  # `if (!strcmp(a, b))` is house style; `strcmp(a, b) == 1` is still reported
  bugprone-suspicious-string-compare.WarnOnImplicitComparison: false
WarningsAsErrors: ''
HeaderFilterRegex: '.*/dm/(host|gfx)/.*'
ExcludeHeaderFilterRegex: '.*/dm/(third_party|host/gen|gfx/nvn/include)/.*'
